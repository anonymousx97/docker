#!/usr/bin/env bash

set -e

WORKDIR="/app"
BOT_DIR="${WORKDIR}/ubot"
VENV_SOURCE="${VIRTUAL_ENV}/bin/activate"

init() {
	[[ -f "$VENV_SOURCE" ]] && . "$VENV_SOURCE"

	if [[ -f "/etc/secrets/config.env" ]]; then
		echo "exporting secrets..."
		set -a && . "/etc/secrets/config.env" && set +a
	fi

	if [[ -n "${GH_TOKEN}" ]]; then
		echo "https://${GH_TOKEN}:x-oauth-basic@github.com" >~/.git-credentials
		git config --global credential.helper store
	fi

}

clone() {

	if [[ -z "${UPSTREAM_REPO}" ]]; then
		echo "UPSTREAM_REPO var is not set or is empty"
		exit 1
	fi

	echo "Cloning UPSTREAM_REPO into ${BOT_DIR}"

	git clone -q --depth=1 "${UPSTREAM_REPO}" "$BOT_DIR" || {
		echo "Failed to clone repo."
		exit 1
	}
}

setup_repo() {
	echo "Initiating repo setup..."

	if [[ -d "$BOT_DIR" ]]; then
		echo "running git pull on main repo..."
		git -C "$BOT_DIR" fetch --depth=1 origin
		git -C "$BOT_DIR" reset --hard FETCH_HEAD
	else
		clone
	fi
}

install_reqs() {
	echo "Installing reqs..."
	$(type -p uv) pip -q install --no-cache-dir -r "$BOT_DIR"/req*.txt
}

run_extra_boot_scripts() {
	local directory file

	directory="${BOT_DIR}/scripts"

	[[ ! -d "$directory" ]] && return 0

	cd "$BOT_DIR"

	shopt -s nullglob

	for file in "$directory"/*; do
		if [[ -f "$file" && -x "$file" ]]; then
			echo "Executing $file"
			"$file"
		fi
	done

	shopt -u nullglob

}

serve() {
	# health check bash server
	local port fd

	port="${WEB_PORT:-$PORT}"
	[[ -z "$port" ]] && return 0

	enable -f /usr/lib/bash/accept accept 2>/dev/null || {
		echo "Error: 'accept' builtin unavailable" >&2
		exit 1
	}

	echo "Health check listening on 0.0.0.0:${port}..."

	while accept -b 0.0.0.0 -v fd "$port"; do
		read -r -N 4096 -t 0.05 -u "$fd" _ 2>/dev/null
		printf "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 2\r\nConnection: close\r\n\r\nOK" \
			1>&"$fd" 2>/dev/null
		exec {fd}>&-
	done &
}

run_bot() {
	echo "starting bot..."
	cd "$BOT_DIR"
	bash run
}

run_server() {
	serve

	cd "$WORKDIR"
	while true; do
		local status=0
		timeout --kill-after=2m 3h "$0" --run-bot || status=$?
		if ((status != 124)); then break; fi
		echo "[3-HOUR] automatic restart..."
	done
}

main() {
	setup_repo
	install_reqs
	run_extra_boot_scripts
	run_bot
}

parse-args() {

	for arg in "$@"; do
		case "$arg" in
		--setup-repo) setup_repo ;;
		--install-reqs) install_reqs ;;
		--run-extra-boot-scripts) run_extra_boot_scripts ;;
		--run-bot) run_bot ;;
		--run-server) run_server ;;
		esac
	done

}

# Set env
init

if (($# == 0)); then # No args provided: run everything
	main
else
	parse-args "$@"
fi
