#!/usr/bin/env bash

set -e

export PIP_ROOT_USER_ACTION=ignore PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR="/app"
BOT_DIR="${WORKDIR}/ubot"

if [ -f "/etc/secrets/config.env" ]; then
	echo "exporting secrects..."
	. "/etc/secrets/config.env"
	export $(cut -d= -f1 "/etc/secrets/config.env")
fi

echo "${GH_TOKEN}" >~/.git-credentials
git config --global credential.helper store

clone() {
	cd "$WORKDIR"

	if [ -z "${UPSTREAM_REPO}" ]; then
		echo "UPSTREAM_REPO var is not set or is empty"
		exit 1
	fi

	echo "Cloning UPSTREAM_REPO into ubot"

	git clone -q --depth=1 "${UPSTREAM_REPO}" "$BOT_DIR" || {
		echo "Failed to clone repo."
		exit 1
	}

}

pull() {
	cd "$BOT_DIR"

	echo "running git pull on main repo..."

	# Pull Main Repo
	git pull --rebase

	# Pull ext repo
	if [[ -d "app/modules" ]]; then
		echo "running git pull on external repo..."
		cd app/modules
		git pull --rebase
	fi
}

setup_repo() {
	echo "Initiating repo setup..."

	if [[ -d "$BOT_DIR" ]]; then
		pull
	else
		clone
	fi
}

install_reqs() {
	echo "Installing reqs..."
	cd "$BOT_DIR"
	$(type -p uv) pip -q install --no-cache-dir -r req*.txt
}

run_extra_boot_scripts() {
	local directory="${BOT_DIR}/scripts"

	[[ ! -d "$directory" ]] && return 1

	cd "$BOT_DIR"

	if [[ -n "$(ls -A "$directory")" ]]; then
		for file in "$directory"/*; do
			[[ -f "$file" && -x "$file" ]] && {
				echo "Executing $file"
				"$file"
			}
		done
	fi
}

start_nc_server() {
	local port="${WEB_PORT:-$PORT}"
	[[ -z "$port" ]] && return 0

	local handler="/tmp/http-handler"
	cat >"$handler" <<-'EOF'
		#!/usr/bin/env sh
		echo "HTTP/1.1 200 OK"
		echo "Content-Type: text/plain"
		echo
		echo "web server running..."
	EOF
	chmod +x "$handler"

	busybox nc -ll -p "$port" -e "$handler" &
	echo "web server started at port: ${port}..."
}

run_bot() {
	echo "starting bot..."
	cd "$BOT_DIR" && bash run
}

run_bot_with_timeout() {
	cd "$WORKDIR"
	while true; do
		timeout --kill-after=2m 3h ./setup --run-bot
		[[ "$?" -ne "124" ]] && break
		echo "Started automatic restart..."
	done
}

main() {
	setup_repo
	install_reqs
	run_extra_boot_scripts
	run_bot
}

# No args provided: run everything
# Default behaviour except when run from Dockerfile.webhosts
if [[ $# -eq 0 ]]; then
	main
	exit
fi

for arg in "$@"; do
	case "$arg" in
	--setup-repo)
		setup_repo
		;;
	--install-reqs)
		install_reqs
		;;
	--run-extra-boot-scripts)
		run_extra_boot_scripts
		;;
	--run-bot)
		run_bot
		;;
	--run)
		start_nc_server
		run_bot_with_timeout
		;;
	esac
done
